# Private Studio OS docs (local-only — not for public repo)
docs/CREATIVE_DIRECTION_RECORD.md
docs/RIGHTS_PROVENANCE.md
secrets/
context/.session-lock
context/.deploy-pending


# Build-time generated — refreshed by scripts/fetch-studio-feed.mjs
data/studio-feed.json

# /start ephemeral — router.mjs is currently absent from this repo so this
# file captures the node module-not-found stderr (with absolute local paths).
# Excluded to keep pre-push absolute-path checks clean.
.cache/router-suggest.json
# E1 build-cache.mjs content-hash skip files (local optimization, not repo state)
.cache/*-hash

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# RUM raw exports — anonymized field visits, not committed to the public repo
.cache/rum-raw/
data/rum-raw.ndjson
data/rum-raw.json

# Verification lock — ephemeral run state written by run-build-check.mjs and
# removed on exit. A killed run leaves it behind, so without this a stray
# `git add -A` would commit a lock that describes a process which no longer
# exists. The guard already treats an aged lock as stale, so a committed one
# would be harmless but confusing; better that it can never land.
.cache/verification.lock

# Ad-hoc component QA shots — throwaway captures of a single changed element,
# regenerated on demand. Unlike .cache/theme-matrix/ (which IS tracked here,
# 85 files at HEAD, despite the capture script's "not committed" comment) these
# have no receipt binding them and no reason to be durable. Ignored so a
# `git add -A` cannot sweep them into a commit, which is exactly what happened
# before build-lqip-map caught it — that gate enumerates git-tracked images,
# so newly-tracked scratch PNGs became a coverage drift it correctly refused.
.cache/cta-shots/

# The Desk edition drafts — half-written editions with blank authored fields,
# produced by `news-draft-edition.mjs --prepare` and consumed by the authoring
# session. Never durable, and never publishable until --promote validates them.
.cache/news-drafts/
# S328: deploy-staging-content stages the overlay archive here before shipping it
# over SSH. Pure transport scratch — the deployed tree is the committed artifact.
.cache/staging-content-tmp/

# The Desk trend radar work queue — internal editorial pipeline, regenerated by
# `node scripts/news-trend-radar.mjs --scan`. It declares `publicSafe: false`
# and `data/` IS publicly served (probe: /data/staging-deploy-history.ndjson
# returns 200), so committing it would publish scored judgements about third
# parties' stories ("rejected: vendor content") that no one has reviewed.
# check-public-safe-tracking.mjs enforces this for the whole class.
data/news-desk/topic-queue.json

# Per-render skill cost telemetry — local advisory, churns on every /start
docs/skill-cost-ledger.ndjson

# Private surfaces — never commit (sanitization 2026-06-03)
ignis/output/
.cache/lh-check-*/
.cache/*.out
.cache/gate-out.txt
.cache/*-s17*.txt
.cache/*scratch*.txt
journal/_drafts/
.cache/*.log
# S301: rollback pre-images captured by verify-supabase-runtime.mjs before a
# migration. Live production function/policy definitions — no secrets, and the
# same predicates exist in supabase/migrations/, but this repo is public AND
# publishes its git-tracked tree, so live database internals stay local. The
# canonical rollback remains git history; the receipt records path + digest.
.cache/supabase-preimage-*.sql
.cache/buildcheck-s201.txt

# Changelog drafts — honest-dark, founder-review-required, not committed (S230)
context/changelog-drafts/

# Build-output captures contain absolute dev paths — never commit (S214/S230)
.cache/*.txt

# Local-only Obelisk broker sidecars preserved from prior sessions; canonical home is studio-ops.
.cache/obelisk-broker.*.mjs

# S275: ark transport ledgers are volatile local caches — 364KB of identical
# sig-mismatch noise was riding into unrelated commits. The dossier builder
# reads them from disk; they never belong in history.
.cache/ark-sig-fails.ndjson
.cache/ark-drained.ndjson

# S335 token diet: per-session visual/link snapshot dirs are working files, not
# repo state. ~360MB of PNGs across four near-duplicate theme-matrix snapshots
# and two visual-merge runs were tracked and read by nothing. Receipts that
# matter live in docs/visual-qa/ and docs/mobile-audit/; .cache/theme-matrix/
# stays tracked (it is the hash-bound CANON-053 corpus).
.cache/s3[0-9][0-9]-*/
.cache/audit-shots-full/
.cache/supabase-preimage-*.sql
.cache/supabase-migration-last.json
.cache/postbuild-fs-trace.ndjson
.cache/postbuild-ordering.json
