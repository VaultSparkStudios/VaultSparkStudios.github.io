# edge 301 — the page painted before it redirected, and the two mechanisms could
# drift. The stub files are gone; the redirect now happens at the edge like every
# other retired route. Cloudflare preserves the query string, which the Obelisk
# callback depends on.
/obelisk-passport/login                         /login                                             301
/obelisk-passport/callback                      /auth/callback                                     301
/vault-treasury                                 /vault-member/                                     301
